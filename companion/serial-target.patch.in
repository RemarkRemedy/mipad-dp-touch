@@ -273,6 +275,51 @@
     }
     @objc private func refreshStatus() { run("status") }
     @objc private func fixMicrophone() { run("fix-microphone") }
+
+    private static let dataFolder = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent("Library/Application Support/Pad Display")
+
+    @objc private func companionRequest(_ notification: Notification) {
+        guard !running, let token = notification.object as? String, UUID(uuidString: token) != nil else { return }
+        let req = Self.dataFolder.appendingPathComponent("requests").appendingPathComponent(token)
+        guard let data = try? Data(contentsOf: req),
+              let fields = try? JSONDecoder().decode([String: String].self, from: data),
+              let serial = fields["serial"], serial.range(of: "^[A-Za-z0-9_-]{1,128}$", options: .regularExpression) != nil,
+              let action = fields["action"] else { return }
+        do {
+            let selection = Self.dataFolder.appendingPathComponent("selected-serial")
+            if action == "select" {
+                if (try? String(contentsOf: selection, encoding: .utf8)) != serial {
+                    try serial.write(to: selection, atomically: true, encoding: .utf8)
+                    wakePolicy.disarm()
+                    expectedMac = false
+                    autoBrightness = nil
+                    hasSelectedDisplay = false
+                    refreshStatus()
+                }
+            } else {
+                guard (try? String(contentsOf: selection, encoding: .utf8)) == serial else {
+                    throw NSError(domain: "Pad Display", code: 1, userInfo: [NSLocalizedDescriptionKey: "Select this tablet before using its controls."])
+                }
+                switch action {
+                case "android": useAndroid()
+                case "display": showMac()
+                case "brightness-auto", "brightness-manual": run(action)
+                case "fix-microphone": fixMicrophone()
+                case "open-panel": panel.makeKeyAndOrderFront(nil); NSApp.activate(ignoringOtherApps: true)
+                case "toggle-audio": toggleAudio()
+                case "toggle-wake": toggleWake()
+                default: return
+                }
+            }
+            try "OK".write(to: req.appendingPathExtension("reply"), atomically: true, encoding: .utf8)
+        } catch {
+            try? error.localizedDescription.write(to: req.appendingPathExtension("reply"), atomically: true, encoding: .utf8)
+        }
+        try? FileManager.default.removeItem(at: req)
+    }
+
+    private var hasSelectedDisplay = false
 
     private func showError(_ message: String) {
         NSApp.activate(ignoringOtherApps: true)
