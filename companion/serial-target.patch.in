+    private static let folder = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent("Library/Application Support/Pad Display")
+    private static var journal = WindowJournal(url: folder.appendingPathComponent("windows.json"))
+    private static var journalSerial: String?
 
     private static func load() throws {
+        let serial = try String(contentsOf: folder.appendingPathComponent("selected-serial"), encoding: .utf8)
+        if serial != journalSerial {
+            journal = WindowJournal(url: folder.appendingPathComponent("windows-" + serial + ".json"))
+            journalSerial = serial
+            loaded = false
+        }
         if !loaded { saved = try journal.load(); loaded = true }
     }
 
